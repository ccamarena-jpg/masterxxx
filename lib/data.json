      "sessions": [
        "01 oct · Entorno e industria",
        "03 oct · Capacidades y ventaja competitiva",
        "29 oct · Aspiraciones y estrategia corporativa",
        "12 nov · Ejecución y examen final"
      ],
      "cases": [
