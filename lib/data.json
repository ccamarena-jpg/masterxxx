      "id": "ES",
      "name": "Estrategia de Segmentación",
      "hours": 16,
      "mode": "Presencial",
      "professor": "Pilar Bermúdez Núñez",
      "summary": "Diseña estrategias de segmentación con análisis de datos, targeting y posicionamiento para crear propuestas de valor diferenciadas.",
      "evaluation": "Participación 10% · Evaluación escrita 20% · Simulador 40% · Avances 10% · Trabajo final 20%",
      "sessions": [
        "02 oct · Marco STP y criterios B2C/B2B",
        "16 oct · Insights, JTBD y análisis de datos",
        "30 oct · Selección de segmentos y simulador",
        "13 nov · Propuesta de valor, posicionamiento e IA"
      ],
      "cases": [
        "All Nutrition (B): Quantitative Research for Market Segmentation",
        "Marketing Simulation: Managing Segments and Customers",
        "Trabajo integrador final"
      ]
    },
